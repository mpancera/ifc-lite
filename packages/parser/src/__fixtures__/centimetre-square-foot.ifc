ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('centimetre-square-foot.ifc','2026-08-09T00:00:00',(''),(''),'ifc-lite fixture','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* The half-converted imperial template: the length unit was switched to
   centimetres, the area and volume units were not. Perfectly valid IFC, and
   every area in the file is wrong by a factor of about ten. Invisible until
   length and area are put in the same row. */
#1=IFCPROJECT('0FiXtUrE00MiXeDuNiTs01',$,'Fixture',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12,#13,#16));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.CENTI.,.METRE.);
#12=IFCCONVERSIONBASEDUNIT(#100,.AREAUNIT.,'SQUARE FOOT',#101);
#13=IFCCONVERSIONBASEDUNIT(#102,.VOLUMEUNIT.,'CUBIC FOOT',#103);
#16=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#100=IFCDIMENSIONALEXPONENTS(2,0,0,0,0,0,0);
#101=IFCMEASUREWITHUNIT(IFCAREAMEASURE(0.09290304),#104);
#102=IFCDIMENSIONALEXPONENTS(3,0,0,0,0,0,0);
#103=IFCMEASUREWITHUNIT(IFCVOLUMEMEASURE(0.028316846592),#105);
#104=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#105=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0FiXtUrE00SiTe000000X1',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#40=IFCBUILDING('0FiXtUrE00BuiLdInG00X1',$,'Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#41=IFCLOCALPLACEMENT(#31,#21);
#50=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00EGX1',$,'EG',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#41,#21);
#60=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00OGX1',$,'OG',$,$,#61,$,$,.ELEMENT.,320.);
#61=IFCLOCALPLACEMENT(#41,#62);
#62=IFCAXIS2PLACEMENT3D(#63,$,$);
#63=IFCCARTESIANPOINT((0.,0.,320.));
#80=IFCRELAGGREGATES('0FiXtUrE00ReL0PrJSiX01',$,$,$,#1,(#30));
#81=IFCRELAGGREGATES('0FiXtUrE00ReL0SiTBlX01',$,$,$,#30,(#40));
#82=IFCRELAGGREGATES('0FiXtUrE00ReL0BlDStX01',$,$,$,#40,(#50,#60));
ENDSEC;
END-ISO-10303-21;
