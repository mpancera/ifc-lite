ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('foot.ifc','2026-08-09T00:00:00',(''),(''),'ifc-lite fixture','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Imperial, and consistently so. The length unit is not an IfcSIUnit at all
   but an IfcConversionBasedUnit, so the scale has to come from the conversion
   factor rather than from a prefix. */
#1=IFCPROJECT('0FiXtUrE00FoOt00000001',$,'Fixture',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12,#13,#16));
#11=IFCCONVERSIONBASEDUNIT(#100,.LENGTHUNIT.,'FOOT',#101);
#12=IFCCONVERSIONBASEDUNIT(#102,.AREAUNIT.,'SQUARE FOOT',#103);
#13=IFCCONVERSIONBASEDUNIT(#104,.VOLUMEUNIT.,'CUBIC FOOT',#105);
#16=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#100=IFCDIMENSIONALEXPONENTS(1,0,0,0,0,0,0);
#101=IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(0.3048),#106);
#102=IFCDIMENSIONALEXPONENTS(2,0,0,0,0,0,0);
#103=IFCMEASUREWITHUNIT(IFCAREAMEASURE(0.09290304),#107);
#104=IFCDIMENSIONALEXPONENTS(3,0,0,0,0,0,0);
#105=IFCMEASUREWITHUNIT(IFCVOLUMEMEASURE(0.028316846592),#108);
#106=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#107=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#108=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0FiXtUrE00SiTe000000F1',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#40=IFCBUILDING('0FiXtUrE00BuiLdInG00F1',$,'Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#41=IFCLOCALPLACEMENT(#31,#21);
/* 0 and 10 FEET, which is 0 and 3.048 m. */
#50=IFCBUILDINGSTOREY('0FiXtUrE00StOrEyLvL1F1',$,'Level 1',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#41,#21);
#60=IFCBUILDINGSTOREY('0FiXtUrE00StOrEyLvL2F1',$,'Level 2',$,$,#61,$,$,.ELEMENT.,10.);
#61=IFCLOCALPLACEMENT(#41,#62);
#62=IFCAXIS2PLACEMENT3D(#63,$,$);
#63=IFCCARTESIANPOINT((0.,0.,10.));
#80=IFCRELAGGREGATES('0FiXtUrE00ReL0PrJSiF01',$,$,$,#1,(#30));
#81=IFCRELAGGREGATES('0FiXtUrE00ReL0SiTBlF01',$,$,$,#30,(#40));
#82=IFCRELAGGREGATES('0FiXtUrE00ReL0BlDStF01',$,$,$,#40,(#50,#60));
ENDSEC;
END-ISO-10303-21;
