ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('no-units.ifc','2026-08-09T00:00:00',(''),(''),'ifc-lite fixture','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* No IfcUnitAssignment. IfcProject.UnitsInContext is OPTIONAL in the schema,
   so this file is legal — and the number 3000 in it means nothing. Geometry
   still has to draw, so the scale extractor falls back to metres; anything
   that reports a height to a person must refuse instead. */
#1=IFCPROJECT('0FiXtUrE00NoUnItS00001',$,'Fixture',$,$,$,$,(#20),$);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0FiXtUrE00SiTe000000N1',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#40=IFCBUILDING('0FiXtUrE00BuiLdInG00N1',$,'Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#41=IFCLOCALPLACEMENT(#31,#21);
#50=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00EGN1',$,'EG',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#41,#21);
#60=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00OGN1',$,'OG',$,$,#61,$,$,.ELEMENT.,3000.);
#61=IFCLOCALPLACEMENT(#41,#62);
#62=IFCAXIS2PLACEMENT3D(#63,$,$);
#63=IFCCARTESIANPOINT((0.,0.,3000.));
#80=IFCRELAGGREGATES('0FiXtUrE00ReL0PrJSiN01',$,$,$,#1,(#30));
#81=IFCRELAGGREGATES('0FiXtUrE00ReL0SiTBlN01',$,$,$,#30,(#40));
#82=IFCRELAGGREGATES('0FiXtUrE00ReL0BlDStN01',$,$,$,#40,(#50,#60));
ENDSEC;
END-ISO-10303-21;
