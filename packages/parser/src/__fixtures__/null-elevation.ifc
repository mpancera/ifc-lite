ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('null-elevation.ifc','2026-08-09T00:00:00',(''),(''),'ifc-lite fixture','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* IfcBuildingStorey.Elevation is OPTIONAL. Storey #60 leaves it unset and puts
   its height in the placement instead, which is what several exporters do. The
   two are NOT interchangeable to a reader: an elevation attribute is what the
   architect wrote down, a placement is an inference. */
#1=IFCPROJECT('0FiXtUrE00NuLLeLeVaT01',$,'Fixture',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12,#13,#14));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0FiXtUrE00SiTe000000P1',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#40=IFCBUILDING('0FiXtUrE00BuiLdInG00P1',$,'Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#41=IFCLOCALPLACEMENT(#31,#21);
/* Elevation written down. */
#50=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00EGP1',$,'EG',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#41,#21);
/* Elevation absent; the placement says 3000 mm. */
#60=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00OGP1',$,'OG',$,$,#61,$,$,.ELEMENT.,$);
#61=IFCLOCALPLACEMENT(#41,#62);
#62=IFCAXIS2PLACEMENT3D(#63,$,$);
#63=IFCCARTESIANPOINT((0.,0.,3000.));
#80=IFCRELAGGREGATES('0FiXtUrE00ReL0PrJSiP01',$,$,$,#1,(#30));
#81=IFCRELAGGREGATES('0FiXtUrE00ReL0SiTBlP01',$,$,$,#30,(#40));
#82=IFCRELAGGREGATES('0FiXtUrE00ReL0BlDStP01',$,$,$,#40,(#50,#60));
ENDSEC;
END-ISO-10303-21;
