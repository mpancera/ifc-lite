ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('centimetre.ifc','2026-08-09T00:00:00',(''),(''),'ifc-lite fixture','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Centimetres. The elevations are the ones measured on a real model: read at
   face value this is a 609 metre building. */
#1=IFCPROJECT('0FiXtUrE00CeNtIMeTrE01',$,'Fixture',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12,#13,#14));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.CENTI.,.METRE.);
#12=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0FiXtUrE00SiTe000000C1',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#40=IFCBUILDING('0FiXtUrE00BuiLdInG00C1',$,'Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#41=IFCLOCALPLACEMENT(#31,#21);
/* 0 / 240 / 609.6 cm is 0 / 2.4 / 6.096 m. */
#50=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00UGC1',$,'UG',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#41,#21);
#60=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy00EGC1',$,'EG',$,$,#61,$,$,.ELEMENT.,240.);
#61=IFCLOCALPLACEMENT(#41,#62);
#62=IFCAXIS2PLACEMENT3D(#63,$,$);
#63=IFCCARTESIANPOINT((0.,0.,240.));
#70=IFCBUILDINGSTOREY('0FiXtUrE00StOrEyRoOfC1',$,'Roof',$,$,#71,$,$,.ELEMENT.,609.6);
#71=IFCLOCALPLACEMENT(#41,#72);
#72=IFCAXIS2PLACEMENT3D(#73,$,$);
#73=IFCCARTESIANPOINT((0.,0.,609.6));
#80=IFCRELAGGREGATES('0FiXtUrE00ReL0PrJSiC01',$,$,$,#1,(#30));
#81=IFCRELAGGREGATES('0FiXtUrE00ReL0SiTBlC01',$,$,$,#30,(#40));
#82=IFCRELAGGREGATES('0FiXtUrE00ReL0BlDStC01',$,$,$,#40,(#50,#60,#70));
ENDSEC;
END-ISO-10303-21;
