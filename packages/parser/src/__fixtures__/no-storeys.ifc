ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('no-storeys.ifc','2026-08-09T00:00:00',(''),(''),'ifc-lite fixture','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* A site with no building storeys — the shape of a terrain model or a
   georeferencing test. Perfectly ordinary, and NOT an error: a reader must not
   treat "has no storeys" as "lost its storeys", or every reference storey
   turns into a missing-storey finding against a model that never had one. */
#1=IFCPROJECT('0FiXtUrE00NoStOrEyS001',$,'Fixture',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12,#13,#14));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0FiXtUrE00SiTe000000T1',$,'Gelaende',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#80=IFCRELAGGREGATES('0FiXtUrE00ReL0PrJSiT01',$,$,$,#1,(#30));
ENDSEC;
END-ISO-10303-21;
