ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('millimetre.ifc','2026-08-09T00:00:00',(''),(''),'ifc-lite fixture','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* The everyday case: prefixed length unit, unprefixed derived units. */
#1=IFCPROJECT('0FiXtUrE00MiLLiMeTrE01',$,'Fixture',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11,#12,#13,#14));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0FiXtUrE00SiTe000000M1',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#40=IFCBUILDING('0FiXtUrE00BuiLdInG00M1',$,'Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#41=IFCLOCALPLACEMENT(#31,#21);
/* Elevations in FILE units. -2430 mm is -2.43 m. */
#50=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy0U01M1',$,'U01',$,$,#51,$,$,.ELEMENT.,-2430.);
#51=IFCLOCALPLACEMENT(#41,#52);
#52=IFCAXIS2PLACEMENT3D(#53,$,$);
#53=IFCCARTESIANPOINT((0.,0.,-2430.));
#60=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy0E00M1',$,'E00',$,$,#61,$,$,.ELEMENT.,0.);
#61=IFCLOCALPLACEMENT(#41,#21);
#70=IFCBUILDINGSTOREY('0FiXtUrE00StOrEy0O01M1',$,'O01',$,$,#71,$,$,.ELEMENT.,3500.);
#71=IFCLOCALPLACEMENT(#41,#72);
#72=IFCAXIS2PLACEMENT3D(#73,$,$);
#73=IFCCARTESIANPOINT((0.,0.,3500.));
#80=IFCRELAGGREGATES('0FiXtUrE00ReL0PrJSiT01',$,$,$,#1,(#30));
#81=IFCRELAGGREGATES('0FiXtUrE00ReL0SiTBlD01',$,$,$,#30,(#40));
#82=IFCRELAGGREGATES('0FiXtUrE00ReL0BlDStY01',$,$,$,#40,(#50,#60,#70));
ENDSEC;
